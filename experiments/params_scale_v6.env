# Cooperative fixed-load v6 scalability parameters

EMERGENCY_RATE=${EMERGENCY_RATE:-10m}

# Common emergency vehicle budget
BASELINE_FLAT_SHAPING=${BASELINE_FLAT_SHAPING:-1}
SDNV_TOTAL_RATE=${SDNV_TOTAL_RATE:-40mbit}
SDNV_TOTAL_CEIL=${SDNV_TOTAL_CEIL:-40mbit}
SDNV_USE_FQ_CODEL=${SDNV_USE_FQ_CODEL:-1}

# Emergency vehicle protection once ECM is activated in SDNV
SDNV_EMERGENCY_HP_RATE=${SDNV_EMERGENCY_HP_RATE:-40mbit}
SDNV_EMERGENCY_HP_CEIL=${SDNV_EMERGENCY_HP_CEIL:-40mbit}
SDNV_EMERGENCY_BE_RATE=${SDNV_EMERGENCY_BE_RATE:-0.100mbit}
SDNV_EMERGENCY_BE_CEIL=${SDNV_EMERGENCY_BE_CEIL:-0.100mbit}

# Cooperative fixed-load model with direct emergency-vehicle contention:
# - primary emergency UDP from sta1: 10 Mbit/s
# - aggregate helper UDP: 10 Mbit/s
# - aggregate helper TCP offered load: 80 Mbit/s
# - aggregate helper TCP cap in SDNV after trigger: 10 Mbit/s
SDNV_V6_HELPER_UDP_TOTAL_MBIT=${SDNV_V6_HELPER_UDP_TOTAL_MBIT:-10}
SDNV_V6_HELPER_TCP_TOTAL_MBIT=${SDNV_V6_HELPER_TCP_TOTAL_MBIT:-80}
SDNV_V6_HELPER_TCP_LIMIT_TOTAL_MBIT=${SDNV_V6_HELPER_TCP_LIMIT_TOTAL_MBIT:-10}
SDNV_V6_HELPER_MIN_UDP_MBIT=${SDNV_V6_HELPER_MIN_UDP_MBIT:-0.25}
SDNV_V6_HELPER_MIN_TCP_MBIT=${SDNV_V6_HELPER_MIN_TCP_MBIT:-0.25}

# Ports
SDNV_EMERGENCY_PORT=${SDNV_EMERGENCY_PORT:-5001}
SDNV_BEST_EFFORT_PORT=${SDNV_BEST_EFFORT_PORT:-5002}
SDNV_LATENCY_PORT=${SDNV_LATENCY_PORT:-5003}
SDNV_BACKGROUND_LATENCY_PORT=${SDNV_BACKGROUND_LATENCY_PORT:-5004}
SDNV_COOP_UDP_PORT=${SDNV_COOP_UDP_PORT:-5005}
SDNV_HELPER_UDP_PORT_BASE=${SDNV_HELPER_UDP_PORT_BASE:-5100}
SDNV_EMAPT_PORT=${SDNV_EMAPT_PORT:-6000}
SDNV_PRIORITY_PORTS=${SDNV_PRIORITY_PORTS:-5001,5003,6000}
SDNV_EMERGENCY_PRIORITY_PORTS=${SDNV_EMERGENCY_PRIORITY_PORTS:-5001,5003,6000}
SDNV_LATENCY_INTERVAL=${SDNV_LATENCY_INTERVAL:-0.2}
SDNV_EMAPT_BG_DURATION=${SDNV_EMAPT_BG_DURATION:-10}

# Sweep definition
SDNV_COUNTS=${SDNV_COUNTS:-5,10,15,20}

# Topology / mobility
SDNV_AREA_SIZE=${SDNV_AREA_SIZE:-1000}
SDNV_SPEED_KMH=${SDNV_SPEED_KMH:-60}
SDNV_WIFI_MODE=${SDNV_WIFI_MODE:-g}
SDNV_USE_BOTH_APS=${SDNV_USE_BOTH_APS:-0}
SDNV_AUTO_ASSOCIATION=${SDNV_AUTO_ASSOCIATION:-0}

# Flow timing
SDNV_DURATION=${SDNV_DURATION:-60}
SDNV_WARMUP=${SDNV_WARMUP:-10}
